# ==============================================================================
# GYM VIP Mobile — Plantilla de Configuración de Keystore de Firma
# Copie este archivo a keystore.properties e ingrese las rutas y credenciales reales
# O configure las variables de entorno equivalentes:
# GYMVIP_KEYSTORE_PATH, GYMVIP_KEYSTORE_PASSWORD, GYMVIP_KEY_ALIAS, GYMVIP_KEY_PASSWORD
# ==============================================================================
storeFile=path/to/your/release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
