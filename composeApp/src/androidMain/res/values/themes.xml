<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de inicio Splash nativo con el azul profundo oficial de GYM VIP (#0B1320) -->
    <style name="Theme.GymVip.Splash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">#0B1320</item>
        <item name="android:navigationBarColor">#0B1320</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Tema principal de la aplicación tras la carga de Compose -->
    <style name="Theme.GymVip" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B1320</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
